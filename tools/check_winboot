#!/bin/sh

shim_signed_url="http://archive.ubuntu.com/ubuntu/pool/main/s/shim-signed/shim-signed_1.59+15.8-0ubuntu2_amd64.deb"
shim_url="http://archive.ubuntu.com/ubuntu/pool/main/s/shim/shim_15.8-0ubuntu2_amd64.deb"
shim_blacklist_md5="a1fe8e36277b45ceeeabc5ce38df57bd"

# Détecter le gestionnaire de paquets dans WSL
if command -v apt > /dev/null 2>&1; then
    PKG_INSTALL="apt install -y"
elif command -v apt-get > /dev/null 2>&1; then
    PKG_INSTALL="apt-get install -y"
elif command -v dnf > /dev/null 2>&1; then
    PKG_INSTALL="dnf install -y"
elif command -v pacman > /dev/null 2>&1; then
    PKG_INSTALL="pacman -S --noconfirm"
else
    echo "Error: No supported package manager found"
    exit 1
fi

test -e /usr/lib/grub/i386-pc/moddep.lst || {
    echo "Installing grub-pc-bin"
    $PKG_INSTALL grub-pc-bin
}
test -e /usr/lib/grub/x86_64-efi/moddep.lst || {
    echo "Installing grub-efi-amd64-bin"
    $PKG_INSTALL grub-efi-amd64-bin
}
test -e /usr/lib/grub/i386-efi/moddep.lst || {
    echo "Installing grub-efi-ia32-bin"
    $PKG_INSTALL grub-efi-ia32-bin
}
test -e /usr/lib/shim/shim.efi.signed -o -e /usr/lib/shim/shimx64.efi.signed || {
    echo "Installing shim-signed..."
    $PKG_INSTALL shim-signed
}
test -e /usr/bin/sbsign || {
    echo "Installing sbsigntool..."
    $PKG_INSTALL sbsigntool
}
test -e /usr/bin/openssl || {
    echo "Installing openssl..."
    $PKG_INSTALL openssl
}
test -e .key || {
    echo "Generating new Secure Boot key..."
    mkdir -p .key
    USER=$(whoami)
    openssl req -new -x509 -newkey rsa:2048 \
        -keyout ".key/${USER}_wubi.key" \
        -out ".key/${USER}_wubi.crt" \
        -nodes -days 3650 -subj "/CN=${USER} Wubi/"
    openssl x509 -in ".key/${USER}_wubi.crt" \
        -out ".key/${USER}_wubi.cer" -outform DER
}
